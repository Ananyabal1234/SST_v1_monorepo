# Copy to docker/.env.prod and set secrets before `docker compose ... up`.
# DATABASE_URL host must be the Compose service name `postgres` (port 5432 inside the network).

DATABASE_URL=postgresql://sst:sst@postgres:5432/sst?schema=public
JWT_ACCESS_SECRET=change-me-access-min-32-chars-long!!
JWT_REFRESH_SECRET=change-me-refresh-min-32-chars-long!
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
PORT=3000
# Browser origin for the SPA (Compose web on port 80)
CORS_ORIGIN=http://localhost
APP_LOGIN_URL=http://localhost
LOG_LEVEL=info

# Optional SMTP (leave SMTP_HOST empty to disable outbound email)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Do NOT set SEED_* for production. Seed is not run by the API entrypoint.
# For a greenfield demo only, see DEPLOY_V1.md (one-time prisma:seed from a one-off container).
